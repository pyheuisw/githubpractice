pipeline {
    agent any

    triggers {
        pollSCM('H/5 * * * *')
        cron('TZ=Asia/Seoul\n0 15 * * 1-5')
    }
    
    stages {
        stage('Windows 실행 확인') {
            steps {
                echo 'Jenkinsfile loaded from GitHub'
                bat 'whoami'
                bat '"C:\\Users\\comes\\AppData\\Local\\Programs\\Python\\Python313\\python.exe" --version'
            }
        }

        stage('가상환경 준비') {
            steps {
                dir('automationexercise-checkout') {
                    bat '"C:\\Users\\comes\\AppData\\Local\\Programs\\Python\\Python313\\python.exe" -m venv .venv'
                    bat '.venv\\Scripts\\python.exe --version'
                    bat '.venv\\Scripts\\python.exe -m pip install -r requirements.txt'
                }
            }
        }

                stage('결제 테스트 실행') {
            steps {
                dir('automationexercise-checkout') {
                    bat '.venv\\Scripts\\python.exe -m pytest -v tests/test_first_product_checkout.py'
                }
            }
        }
    }
}